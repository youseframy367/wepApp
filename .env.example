# =====================================================================
# Environment Configuration
# =====================================================================
# This is an EXAMPLE file. Copy it to `.env.local` and fill in your values:
#   cp .env.example .env.local
# DO NOT commit `.env.local` (it is gitignored to protect your secrets).
# =====================================================================

# The production domain of your website (no trailing slash).
# Change this when you move the site to a new domain.
NEXT_PUBLIC_SITE_URL=https://exclusivemovies.com

# Base URL of the backend API (e.g. https://api.exclusivemovies.com)
NEXT_PUBLIC_API_URL=https://api.exclusivemovies.com

# Contact email shown in the site (Header / Footer mailto links)
NEXT_PUBLIC_CONTACT_EMAIL=info@exclusivemovies.com
